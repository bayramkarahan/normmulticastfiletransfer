install_debscriptservice: first FORCE
	@test -d $(INSTALL_ROOT)/lib/systemd/system/ || mkdir -p $(INSTALL_ROOT)/lib/systemd/system/
	$(QINSTALL) /home/etapadmin/Masaüstü/normmulticastfiletransfer/multicastfiletransferclient/data/multicastdebinstaller@.service $(INSTALL_ROOT)/lib/systemd/system/multicastdebinstaller@.service

uninstall_debscriptservice: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/lib/systemd/system/multicastdebinstaller@.service
	-$(DEL_DIR) $(INSTALL_ROOT)/lib/systemd/system/ 


