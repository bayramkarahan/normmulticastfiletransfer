	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../../multicastfiletransferserver/multicastfileserver.h ../../multicastfiletransferserver/normbandwidthestimator.h ../../multicastfiletransferserver/normnetworkprobe.h ../../multicastfiletransferserver/normsender.h ../../multicastfiletransferserver/normsenderworker.h ../../multicastfiletransferserver/progressdialog.h ../../multicastfiletransferserver/protocol.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../multicastfiletransferserver/main.cpp ../../multicastfiletransferserver/multicastfileserver.cpp ../../multicastfiletransferserver/normbandwidthestimator.cpp ../../multicastfiletransferserver/normnetworkprobe.cpp ../../multicastfiletransferserver/normsender.cpp ../../multicastfiletransferserver/normsenderworker.cpp ../../multicastfiletransferserver/progressdialog.cpp $(DISTDIR)/


